# Server-side Next.js fetches (SSR) — temporary production ALB until custom HTTPS domain
INTERNAL_API_BASE_URL=http://127.0.0.1:3000/api/v1

# Browser-originated API calls — same-origin proxy path in production
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api/v1

# Production example (non-secret):
# NEXT_PUBLIC_API_BASE_URL=/api/backend
# INTERNAL_BACKEND_ORIGIN=http://eaziacall-prod-alb-2044075500.us-east-1.elb.amazonaws.com
# INTERNAL_API_BASE_URL=http://eaziacall-prod-alb-2044075500.us-east-1.elb.amazonaws.com/api/v1

# Optional public site origin for marketing metadataBase / sitemap absolute URLs (no invented domain).
# NEXT_PUBLIC_SITE_URL=https://www.example.com
