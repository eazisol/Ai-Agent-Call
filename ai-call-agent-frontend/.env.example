# Server-side Next.js fetches (SSR / route handlers) — direct CloudFront in production
INTERNAL_API_BASE_URL=http://localhost:3000/api/v1

# Browser-originated API calls — same-origin proxy path in production (/api/backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Production example (non-secret):
# INTERNAL_API_BASE_URL=https://dl1t1qnfxrdka.cloudfront.net/api/v1
# NEXT_PUBLIC_API_BASE_URL=/api/backend
# INTERNAL_BACKEND_ORIGIN=https://dl1t1qnfxrdka.cloudfront.net