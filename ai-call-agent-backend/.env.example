NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
PROTOTYPE_API_ENABLED=true
LOG_LEVEL=log

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-a-local-password
DATABASE_NAME=ai_call_agent
DATABASE_SSL=false

# Initial AWS deployment: Redis is not required by runtime features yet (readiness-only).
# Keep REDIS_ENABLED=false until ElastiCache is provisioned and needed.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=1500

OBJECT_STORAGE_ENABLED=false
# Local dev (MinIO via docker compose): set enabled=true and use values below.
#   docker compose up -d minio minio-init
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=eazi-ai-call
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_HEALTH_TIMEOUT_MS=2000
# Native AWS S3 (ECS Task Role): set enabled=true, region, bucket; leave endpoint empty;
# omit OBJECT_STORAGE_ACCESS_KEY_ID and OBJECT_STORAGE_SECRET_ACCESS_KEY.
# Partial static credentials (only one of access key / secret key) are invalid.

KNOWLEDGE_MAX_FILE_BYTES=10485760
VOICE_CATALOG_CACHE_TTL_SECONDS=3600
VOICE_CLONE_MAX_SAMPLE_BYTES=26214400
VOICE_CLONE_MAX_SAMPLES=5

TELEPHONY_PROVIDER=twilio
VOICE_AGENT_PROVIDER=openai_realtime

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_DEFAULT_VOICE=alloy
OPENAI_DEFAULT_INSTRUCTIONS=You are a helpful EaziAiCall receptionist. Speak clearly and professionally.

ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TIMEOUT_MS=20000
ELEVENLABS_DEFAULT_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_DEFAULT_VOICE_MALE=pNInz6obpgDQGcFmaJgB
ELEVENLABS_DEFAULT_VOICE_NEUTRAL=JBFqnCBsd6RMkjVDRZzb

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=replace-with-a-test-auth-token
TWILIO_PHONE_NUMBER=
TWILIO_TIMEOUT_MS=20000
TWILIO_VALIDATE_SIGNATURES=false

VOICE_STREAM_SIGNING_SECRET=replace-with-at-least-32-random-characters
VOICE_STREAM_TOKEN_TTL_SECONDS=120
VOICE_STREAM_MAX_DURATION_SECONDS=7200
VOICE_STREAM_MAX_MESSAGE_BYTES=1048576

N8N_ENABLED=false
N8N_CALL_COMPLETED_WEBHOOK=

AUTH_JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_RESET_TTL_SECONDS=3600
AUTH_INVITE_TTL_SECONDS=604800
AUTH_BCRYPT_ROUNDS=12
AUTH_PUBLIC_APP_URL=http://localhost:3001
AUTH_ACCESS_COOKIE_NAME=eazi_access
AUTH_REFRESH_COOKIE_NAME=eazi_refresh
AUTH_ORG_COOKIE_NAME=eazi_org
AUTH_BIZ_COOKIE_NAME=eazi_biz
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TIMEOUT_MS=10000

# M12 — Incoming AI Calls
INBOUND_CALL_DEV_STREAM_FALLBACK=false
# Required in production (NODE_ENV=production). Optional in local/test when webhook auth bypass is allowed.
ELEVENLABS_WEBHOOK_SECRET=
